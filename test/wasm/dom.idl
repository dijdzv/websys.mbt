// Deliberately restricted DOM surface for the experimental backend.
// Synthetic receiver isolates the standard built-in buffer value conversion.
interface BufferFixture {
  readonly attribute ArrayBuffer value;
  attribute ArrayBuffer? optionalValue;
  ArrayBuffer echo(ArrayBuffer value);
};
interface Document {
  readonly attribute Element? activeElement;
  Element createElement(DOMString localName);
  Element? querySelector(DOMString selectors);
};
partial interface Element {
  attribute DOMString id;
};
interface Element : Node {
  DOMString? getAttribute(DOMString name);
  Element? insertBefore(Element node, Element? child);
  undefined setAttribute(DOMString name, DOMString value);
  boolean hasAttribute(DOMString name);
  undefined scrollTo(ScrollToOptions options);
};
interface Node : EventTarget {
  boolean isSameNode(Node? otherNode);
  attribute DOMString? textContent;
  readonly attribute Element? parentElement;
};
// Required direction narrows the optional standard argument for this fixture.
interface HTMLElement : Element {
  undefined focus();
};
interface HTMLInputElement : HTMLElement {
  attribute DOMString value;
  attribute DOMString type;
  attribute unsigned long? selectionStart;
  readonly attribute unsigned long? selectionEnd;
  readonly attribute DOMString? selectionDirection;
  undefined setSelectionRange(unsigned long start, unsigned long end, DOMString direction);
};
interface HTMLTextAreaElement : HTMLElement {
  attribute DOMString value;
  readonly attribute unsigned long selectionStart;
  readonly attribute unsigned long selectionEnd;
  readonly attribute DOMString selectionDirection;
  undefined setSelectionRange(unsigned long start, unsigned long end, DOMString direction);
};
interface EventTarget {};
interface mixin EventTargetMethods {
  undefined addEventListener(DOMString type, EventListener callback, boolean capture);
  undefined removeEventListener(DOMString type, EventListener callback, boolean capture);
  boolean dispatchEvent(Event event);
};
EventTarget includes EventTargetMethods;
interface Event {
  constructor(DOMString type, EventInit init);
  readonly attribute DOMString type;
  readonly attribute boolean bubbles;
  readonly attribute boolean cancelable;
  readonly attribute boolean defaultPrevented;
  undefined preventDefault();
};
dictionary EventInit {
  boolean bubbles = false;
  boolean cancelable = false;
  boolean composed = false;
};
callback EventListener = undefined (Event event);

// Narrowed inheritance chain: view/detail remain outside this fixture.
interface UIEvent : Event {};
interface Window {
  long setTimeout(TimeoutCallback callback, long timeout);
  undefined clearTimeout(long id);
  unsigned long requestAnimationFrame(FrameRequestCallback callback);
  undefined cancelAnimationFrame(unsigned long handle);
};
callback FrameRequestCallback = undefined (double timestamp);
callback TimeoutCallback = undefined ();
interface InputEvent : UIEvent {
  readonly attribute boolean isComposing;
};
interface CompositionEvent : UIEvent {
  constructor(DOMString type, CompositionEventInit init);
  readonly attribute DOMString data;
};
dictionary UIEventInit : EventInit {};
dictionary CompositionEventInit : UIEventInit {
  DOMString data = "";
};
dictionary ScrollToOptions {
  double left;
  double top;
};
// Synthetic boundary fixture: required, omitted, null and explicit values.
dictionary TestOptions : TestOptionsBase {
  Element? node;
  DOMString? note;
  boolean enabled = true;
  long count;
  unsigned long unsignedCount;
};
dictionary TestOptionsBase {
  required DOMString title;
  required DOMString? requiredNote;
};
dictionary NestedLeaf {
  required DOMString label;
  long count;
};
dictionary NestedOptions {
  required NestedLeaf child;
  required NestedLeaf? requiredNullable;
  NestedLeaf optionalChild;
  NestedLeaf? nullableChild;
};
