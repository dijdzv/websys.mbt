import {
  "dijdzv/websys-promise-fixture" @web,
  "moonbitlang/async",
  "moonbitlang/async/wasm_async" @bridge,
}

supported_targets = "wasm-gc"

options(
  link: {
    "wasm-gc": {
      "exports": [
        "read_bytes",
        "fetch_body",
        "post_headers",
        "read_required",
        "start",
        "start_value",
        "fetch_text",
        "cancel_stream",
        "read_stream",
      ],
      "use-js-builtin-string": true,
    },
  },
)
