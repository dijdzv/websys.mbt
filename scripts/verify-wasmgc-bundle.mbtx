----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
}
----

async fn checked(command : String, args : Array[String]) -> Unit {
  let result = @process.run(command, args, stdout=@process.read_from_process(), stderr=@process.read_from_process(), no_console_window=true)
  assert_eq(result.exit_code, 0, msg=result.stdout_text() + result.stderr_text())
}

async fn main {
  let temporary = @fs.realpath(@fs.tmpdir(prefix="websys-consumer"))
  let root = temporary.replace_all(old="\\", new="/") + "/bundle"
  println("Checking relocated WasmGC consumer: " + root)
  checked("moon", ["run", "scripts/export-wasmgc.mbtx", "test/promise/generated", root])
  let repeat_result = @process.run("moon", ["run", "scripts/export-wasmgc.mbtx", "test/promise/generated", root], stdout=@process.read_from_process(), stderr=@process.read_from_process(), no_console_window=true)
  assert_true(repeat_result.exit_code != 0, msg="Export must reject an existing destination")
  @fs.mkdir(root + "/consumer")
  for name in ["moon.mod", "moon.pkg", "check.mbt", "gpu_shader.mbt", "gpu_texture.mbt", "gpu_canvas.mbt", "buffer_promise.mbt", "callback.mbt"] {
    @fs.write_binary(root + "/consumer/" + name, @fs.read_binary("test/promise/" + name))
  }
  @fs.write_text(root + "/moon.work", "members = [\"bindings\", \"consumer\"]\n")
  checked("moon", ["-C", root, "run", "scripts/prepare-browser-core.mbtx", "--", "--", "-C", "consumer", "build", "--target", "wasm-gc", "--release", "--deny-warn"])
  checked("node", ["test/promise/run.mjs", root + "/_build/wasm-gc/release/build/dijdzv/websys-promise-tests/websys-promise-tests.wasm", root + "/bindings/runtime.mjs"])
  // Why Not: cleanup must not traverse an unverified replacement of the owned temp root.
  assert_eq(@fs.realpath(temporary), temporary)
  @fs.rmdir(temporary, recursive=true)
  println("Relocated WasmGC source bundle: browser suite passed")
}
