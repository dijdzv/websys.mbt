import {
  "dijdzv/websys-promise-fixture" @web,
  "moonbitlang/async",
  "moonbitlang/async/wasm_async" @bridge,
}

supported_targets = "wasm-gc"

options(
  link: {
    "wasm-gc": {
      "exports": [
        "render_options",
        "encode_clear",
        "submit_clear",
        "gpu_readback",
        "gpu_shader",
        "unsigned_sequence",
        "operation_inputs",
        "buffer_inputs",
        "enum_options",
        "buffer_size_options",
        "gpu_buffer_sample",
        "gpu_discovery",
        "read_optional_response",
        "read_bytes",
        "fetch_body",
        "inspect_response",
        "fetch_metadata",
        "post_headers",
        "post_body",
        "read_required",
        "start",
        "start_value",
        "fetch_text",
        "cancel_stream",
        "read_stream",
      ],
      "use-js-builtin-string": true,
    },
  },
)
