  mipLevels : Int?
  viewPixelWidth : Int
  viewPixelHeight : Int
  layout : XRLayerLayout?
  isStatic : Bool?
  transform : Nullable[XRRigidTransform]
  radius : Double?
  centralHorizontalAngle : Double?
  upperVerticalAngle : Double?
  lowerVerticalAngle : Double?
}

/// Create a new XRGPUEquirectLayerInit
pub fn XRGPUEquirectLayerInit::new(colorFormat~ : GPUTextureFormat, space~ : XRSpace) -> XRGPUEquirectLayerInit {
