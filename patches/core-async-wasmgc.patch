diff --git a/async/wasm_async/wait.mbt b/async/wasm_async/wait.mbt
new file mode 100644
index 00000000..a32cda02
--- /dev/null
+++ b/async/wasm_async/wait.mbt
@@ -0,0 +1,107 @@
+// Copyright (c) 2026 dijdzv
+// SPDX-License-Identifier: MIT
+
+///|
+/// An opaque JavaScript value whose representation is owned by the host.
+#external
+pub type JsValue
+
+///|
+#external
+priv type Subscription
+
+///|
+/// A settled Promise rejection, preserving the original host value.
+pub suberror Rejection {
+  Rejection(JsValue)
+}
+
+///|
+priv struct Waiter {
+  mut coro : @coroutine.Coroutine?
+  mut value : JsValue?
+  mut failure : JsValue?
+}
+
+///|
+#cfg(target="wasm-gc")
+fn subscribe(
+  promise : JsValue,
+  resolve : (JsValue) -> Unit,
+  reject : (JsValue) -> Unit,
+) -> Subscription = "moonbit:async" "subscribe"
+
+///|
+#cfg(target="js")
+extern "js" fn subscribe(
+  promise : JsValue,
+  resolve : (JsValue) -> Unit,
+  reject : (JsValue) -> Unit,
+) -> Subscription =
+  #| (promise, resolve, reject) => {
+  #|   const slot = { resolve, reject };
+  #|   Promise.resolve(promise).then(value => slot.resolve?.(value), reason => slot.reject?.(reason));
+  #|   return slot;
+  #| }
+
+///|
+#cfg(target="wasm-gc")
+fn detach(subscription : Subscription) -> Unit = "moonbit:async" "detach"
+
+///|
+#cfg(target="js")
+extern "js" fn detach(subscription : Subscription) -> Unit =
+  #| slot => { slot.resolve = undefined; slot.reject = undefined; }
+
+///|
+fn[T] promise_reference(promise : @js_async.Promise[T]) -> JsValue = "%identity"
+
+///|
+/// Wait for a host Promise using the selected browser runtime.
+///
+/// Cancellation while suspended detaches callbacks and invokes the caller's
+/// nonthrowing abort action. Rejection or decoding failure after settlement
+/// does not abort settled work. Shared-operation abort ownership stays with
+/// the caller; detachment does not close the underlying host operation.
+pub async fn[T] wait(
+  promise : @js_async.Promise[T],
+  decode : (JsValue) -> T raise,
+  abort : () -> Unit,
+) -> T {
+  let waiter = Waiter::{
+    coro: Some(@coroutine.current_coroutine()),
+    value: None,
+    failure: None,
+  }
+  defer {
+    waiter.coro = None
+    waiter.value = None
+    waiter.failure = None
+  }
+  let subscription = subscribe(
+    promise_reference(promise),
+    value => {
+      if waiter.coro is Some(coro) {
+        waiter.value = Some(value)
+        coro.wake()
+        @event_loop.reschedule()
+      }
+    },
+    reason => {
+      if waiter.coro is Some(coro) {
+        waiter.failure = Some(reason)
+        coro.wake()
+        @event_loop.reschedule()
+      }
+    },
+  )
+  defer detach(subscription)
+  let _ : Unit = {
+    errdefer abort()
+    @coroutine.suspend()
+  }
+  match waiter.failure {
+    Some(reason) => raise Rejection(reason)
+    None => decode(waiter.value.unwrap())
+  }
+}
