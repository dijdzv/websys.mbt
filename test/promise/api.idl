typedef DOMString ResponseText;
interface GPU {
  Promise<GPUAdapter?> requestAdapter();
  GPUTextureFormat getPreferredCanvasFormat();
};
interface GPUAdapter {
  Promise<GPUDevice> requestDevice();
};
interface GPUCanvasContext {
  undefined configure(GPUCanvasConfiguration configuration);
  GPUTexture getCurrentTexture();
  undefined unconfigure();
};
enum GPUCanvasAlphaMode { "opaque", "premultiplied" };
dictionary GPUCanvasConfiguration {
  required GPUDevice device;
  required GPUTextureFormat format;
  GPUTextureUsageFlags usage = 16;
  GPUCanvasAlphaMode alphaMode = "opaque";
};
interface GPUDevice {
  readonly attribute GPUQueue queue;
  GPUCommandEncoder createCommandEncoder();
  GPUSampler createSampler(GPUSamplerDescriptor descriptor);
  GPUBuffer createBuffer(GPUBufferDescriptor descriptor);
  GPUTexture createTexture(GPUTextureDescriptor descriptor);
  GPUShaderModule createShaderModule(GPUShaderModuleDescriptor descriptor);
  GPURenderPipeline createRenderPipeline(GPURenderPipelineDescriptor descriptor);
  Promise<GPURenderPipeline> createRenderPipelineAsync(GPURenderPipelineDescriptor descriptor);
  GPUBindGroup createBindGroup(GPUBindGroupDescriptor descriptor);
  undefined destroy();
};
interface GPUCommandEncoder {
  undefined copyTextureToBuffer(GPUTexelCopyTextureInfo source, GPUTexelCopyBufferInfo destination, GPUExtent3D copySize);
  GPURenderPassEncoder beginRenderPass(GPURenderPassDescriptor descriptor);
  GPUCommandBuffer finish();
};
interface GPURenderPassEncoder {
  undefined setPipeline(GPURenderPipeline pipeline);
  undefined setBindGroup(GPUIndex32 index, GPUBindGroup? bindGroup, optional sequence<GPUBufferDynamicOffset> dynamicOffsets = []);
  undefined draw(GPUSize32 vertexCount, optional GPUSize32 instanceCount = 1, optional GPUSize32 firstVertex = 0, optional GPUSize32 firstInstance = 0);
  undefined end();
};
interface GPUCommandBuffer {};
interface GPUQueue {
  undefined submit(sequence<GPUCommandBuffer> commandBuffers);
  Promise<undefined> onSubmittedWorkDone();
  undefined writeBuffer(GPUBuffer buffer, GPUSize64 bufferOffset, AllowSharedBufferSource data, optional GPUSize64 dataOffset = 0, optional GPUSize64 size);
  undefined writeTexture(GPUTexelCopyTextureInfo destination, AllowSharedBufferSource data, GPUTexelCopyBufferLayout dataLayout, GPUExtent3D size);
};
typedef [EnforceRange] unsigned long GPUIndex32;
typedef [EnforceRange] unsigned long GPUBufferDynamicOffset;
interface GPUShaderModule {};
interface GPUPipelineLayout {};
interface GPUBindGroupLayout {};
interface GPUBindGroup {};
interface GPUExternalTexture {};
interface GPURenderPipeline { GPUBindGroupLayout getBindGroupLayout(unsigned long index); };
enum GPUAutoLayoutMode { "auto" };
dictionary GPUShaderModuleDescriptor { required USVString code; };
dictionary GPUProgrammableStage {
  required GPUShaderModule module;
  USVString entryPoint;
};
dictionary GPUVertexState : GPUProgrammableStage {};
dictionary GPUColorTargetState { required GPUTextureFormat format; };
dictionary GPUFragmentState : GPUProgrammableStage { required sequence<GPUColorTargetState?> targets; };
dictionary GPURenderPipelineDescriptor {
  required (GPUPipelineLayout or GPUAutoLayoutMode) layout;
  required GPUVertexState vertex;
  GPUFragmentState fragment;
};
dictionary GPUBufferBinding {
  required GPUBuffer buffer;
  GPUSize64 offset = 0;
  GPUSize64 size;
};
typedef (GPUSampler or GPUTexture or GPUTextureView or GPUBuffer or GPUBufferBinding or GPUExternalTexture) GPUBindingResource;
dictionary GPUBindGroupEntry { required GPUIndex32 binding; required GPUBindingResource resource; };
dictionary GPUBindGroupDescriptor {
  required GPUBindGroupLayout layout;
  required sequence<GPUBindGroupEntry> entries;
};
interface SequenceProbe {
  undefined unsignedValues(sequence<unsigned long> values);
};
interface ArgumentProbe {
  undefined accept(GPUSize64 size, GPUAddressMode mode, record<DOMString, DOMString> headers);
  undefined defaults(optional unsigned long count = 7, optional DOMString label = "default");
  undefined nullable(GPUAddressMode? mode);
};
typedef (ArrayBuffer or SharedArrayBuffer or [AllowShared] ArrayBufferView) AllowSharedBufferSource;
interface BufferInputProbe {
  undefined accept(AllowSharedBufferSource value);
};
interface GPUTextureView {};
interface GPUTexture {
  readonly attribute unsigned long width;
  readonly attribute unsigned long height;
  GPUTextureView createView();
  undefined destroy();
};
typedef [EnforceRange] unsigned long GPUIntegerCoordinate;
typedef [EnforceRange] unsigned long GPUSize32;
typedef unsigned long GPUTextureUsageFlags;
typedef unsigned long GPUMapModeFlags;
dictionary GPUExtent3DDict {
  required GPUIntegerCoordinate width;
  GPUIntegerCoordinate height = 1;
  GPUIntegerCoordinate depthOrArrayLayers = 1;
};
typedef (sequence<GPUIntegerCoordinate> or GPUExtent3DDict) GPUExtent3D;
enum GPUTextureFormat { "rgba8unorm", "bgra8unorm" };
dictionary GPUTextureDescriptor {
  required GPUExtent3D size;
  required GPUTextureFormat format;
  required GPUTextureUsageFlags usage;
};
dictionary GPUTexelCopyBufferLayout {
  GPUSize64 offset = 0;
  GPUSize32 bytesPerRow;
  GPUSize32 rowsPerImage;
};
dictionary GPUTexelCopyBufferInfo : GPUTexelCopyBufferLayout {
  required GPUBuffer buffer;
};
dictionary GPUTexelCopyTextureInfo {
  required GPUTexture texture;
};
enum GPULoadOp { "load", "clear" };
enum GPUStoreOp { "store", "discard" };
dictionary GPUColorDict {
  required double r;
  required double g;
  required double b;
  required double a;
};
typedef (sequence<double> or GPUColorDict) GPUColor;
dictionary GPURenderPassColorAttachment {
  required GPUTextureView view;
  GPUColor clearValue;
  required GPULoadOp loadOp;
  required GPUStoreOp storeOp;
};
dictionary GPURenderPassDescriptor {
  required sequence<GPURenderPassColorAttachment?> colorAttachments;
};
enum GPUAddressMode { "clamp-to-edge", "repeat", "mirror-repeat" };
enum GPUFilterMode { "nearest", "linear" };
dictionary GPUSamplerDescriptor {
  DOMString label = "";
  GPUAddressMode addressModeU = "clamp-to-edge";
  GPUFilterMode minFilter = "nearest";
};
interface GPUSampler { attribute DOMString label; };
dictionary EnumInputs {
  required AddressModeAlias mode;
  GPUAddressMode? optionalMode;
  sequence<GPUFilterMode> filters;
};
typedef GPUAddressMode AddressModeAlias;
typedef [EnforceRange] unsigned long long GPUSize64;
typedef unsigned long GPUBufferUsageFlags;
dictionary GPUBufferDescriptor {
  required GPUSize64 size;
  required GPUBufferUsageFlags usage;
  boolean mappedAtCreation = false;
};
interface GPUBuffer {
  Promise<undefined> mapAsync(GPUMapModeFlags mode);
  ArrayBuffer getMappedRange();
  undefined unmap();
  undefined destroy();
};
typedef (sequence<sequence<ByteString>> or record<ByteString, ByteString>) HeadersInit;
dictionary PostOptions {
  required DOMString method;
  required HeadersInit headers;
  (Blob or URLSearchParams or USVString)? body;
};
interface Blob {};
interface URLSearchParams {};
interface PostHost {
  Promise<Response> fetch(DOMString url, PostOptions options);
};
interface Response {
  readonly attribute unsigned short status;
  readonly attribute boolean ok;
  readonly attribute Headers headers;
  readonly attribute ReadableStream? body;
  Promise<ResponseText> text();
};
interface Headers {
  ByteString? get(ByteString name);
};
interface ReadableStream {};
interface ReadableStreamDefaultReader {
  constructor(ReadableStream stream);
  Promise<undefined> cancel(DOMString reason);
  Promise<ReadableStreamReadResult> read();
  undefined releaseLock();
};
dictionary ReadableStreamReadResult {
  any value;
  boolean done;
};
interface Window {
  Promise<Response> fetch(DOMString url, RequestInit options);
};
dictionary RequestInit {
  AbortSignal signal;
};
interface AbortSignal {
  readonly attribute boolean aborted;
};
interface AbortController {
  constructor();
  readonly attribute AbortSignal signal;
  undefined abort();
};
interface Values {
  Promise<Response?> readOptionalResponse();
  Promise<RequiredResult> readRequired();
  Promise<long> readInteger();
  Promise<unsigned long> readUnsigned();
  Promise<boolean> readBoolean();
  Promise<double> readDouble();
};
dictionary RequiredResult {
  required boolean done;
};
