    colorFormat: colorFormat,
    depthStencilFormat: Nullable::Undefined,
    textureUsage: None,
    space: space,
    mipLevels: None,
    viewPixelWidth: 0,
    viewPixelHeight: 0,
    layout: None,
    isStatic: None,
    transform: Nullable::Undefined,
    radius: None,
    centralHorizontalAngle: None,
    upperVerticalAngle: None,
    lowerVerticalAngle: None,
  }
}

