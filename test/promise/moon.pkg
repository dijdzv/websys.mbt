import {
  "dijdzv/websys-promise-fixture" @web,
  "moonbitlang/async",
  "moonbitlang/async/wasm_async" @bridge,
}

supported_targets = "wasm-gc"

options(
  link: {
    "wasm-gc": {
      "exports": [ "start", "start_value", "fetch_text", "cancel_stream" ],
      "use-js-builtin-string": true,
    },
  },
)
