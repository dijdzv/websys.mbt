pub extern "js" fn XRGPUBinding::get_sub_image(self : XRGPUBinding, layer : XRCompositionLayer, frame : XRFrame) -> XRGPUSubImage =
  #| (self, layer, frame) => self.getSubImage(layer, frame)

pub extern "js" fn XRGPUBinding::get_sub_image_with_eye(self : XRGPUBinding, layer : XRCompositionLayer, frame : XRFrame, eye : XREye) -> XRGPUSubImage =
  #| (self, layer, frame, eye) => self.getSubImage(layer, frame, ['none', 'left', 'right'][eye])

