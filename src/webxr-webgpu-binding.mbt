pub extern "js" fn XRGPUBinding::new(session : XRSession, device : GPUDevice) -> XRGPUBinding =
  #| (session, device) => new XRGPUBinding(session, device)

pub extern "js" fn XRGPUBinding::get_native_projection_scale_factor(self : XRGPUBinding) -> Double =
  #| (self) => self.nativeProjectionScaleFactor

pub extern "js" fn XRGPUBinding::get_uses_depth_values(self : XRGPUBinding) -> Bool =
  #| (self) => self.usesDepthValues

pub extern "js" fn XRGPUBinding::create_projection_layer(self : XRGPUBinding) -> XRProjectionLayer =
  #| (self) => self.createProjectionLayer()

extern "js" fn XRGPUBinding::create_projection_layer_with_init_ffi(self : XRGPUBinding, init_ : JsValue) -> XRProjectionLayer =
  #| (self, init_) => self.createProjectionLayer(init_)

pub fn XRGPUBinding::create_projection_layer_with_init(self : XRGPUBinding, init_ : XRGPUProjectionLayerInit) -> XRProjectionLayer {
  XRGPUBinding::create_projection_layer_with_init_ffi(self, init_.to_js())
}

