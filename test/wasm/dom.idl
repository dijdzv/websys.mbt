// Deliberately restricted DOM surface for the experimental backend.
interface Document {
  Element createElement(DOMString localName);
  Element? querySelector(DOMString selectors);
};
partial interface Element {
  attribute DOMString id;
};
interface Element : Node {
  DOMString? getAttribute(DOMString name);
  Element? insertBefore(Element node, Element? child);
  undefined setAttribute(DOMString name, DOMString value);
  boolean hasAttribute(DOMString name);
  undefined scrollTo(ScrollToOptions options);
};
interface Node : EventTarget {
  attribute DOMString? textContent;
  readonly attribute Element? parentElement;
};
interface EventTarget {};
interface mixin EventTargetMethods {
  undefined addEventListener(DOMString type, EventListener callback, boolean capture);
  undefined removeEventListener(DOMString type, EventListener callback, boolean capture);
  boolean dispatchEvent(Event event);
};
EventTarget includes EventTargetMethods;
interface Event {
  readonly attribute DOMString type;
};
callback EventListener = undefined (Event event);
dictionary ScrollToOptions {
  double left;
  double top;
};
// Synthetic boundary fixture: required, omitted, null and explicit values.
dictionary TestOptions : TestOptionsBase {
  Element? node;
  DOMString? note;
  boolean enabled = true;
  long count;
};
dictionary TestOptionsBase {
  required DOMString title;
  required DOMString? requiredNote;
};
