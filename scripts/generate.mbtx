import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/process",
}

async fn main {
  let stage = ".work/generated"
  if !@fs.exists(stage + "/src") { @fs.mkdir(stage + "/src", recursive=true) }
  // Only generated files are replaced; package metadata is maintained separately.
  for name in @fs.readdir(stage + "/src") {
    if name.has_suffix(".mbt") { @fs.remove(stage + "/src/" + name) }
  }
  if @fs.exists(stage + "/moon.mod") { @fs.remove(stage + "/moon.mod") }
  @fs.write_file(stage + "/moon.mod.json", @fs.read_file("moon.mod.json"))
  @fs.write_file(stage + "/src/moon.pkg", @fs.read_file("src/moon.pkg"))
  assert_eq(@process.run("mise", ["exec", "--", "bun", "generator/_build/js/release/build/webidl-bindgen.js", "-o", stage + "/src"]), 0)
  let moon = ".tools/moonbit/bin/moon"
  assert_eq(@process.run(moon, ["-C", stage, "fmt", "src"]), 0)
  assert_eq(@process.run(moon, ["-C", stage, "check", "--target", "js", "--deny-warn"]), 0)
  let generated = @fs.readdir(stage + "/src")
  assert_true(generated.contains("shared.mbt"))
  for name in generated {
    if name.has_suffix(".mbt") || name.has_suffix(".md") {
      @fs.write_file("src/" + name, @fs.read_file(stage + "/src/" + name))
    }
  }
  for name in @fs.readdir("src") {
    if name.has_suffix(".mbt") && !generated.contains(name) {
      @fs.remove("src/" + name)
    }
  }
  println("Generated bindings passed validation and were installed.")
}
