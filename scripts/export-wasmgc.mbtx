----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
  "moonbitlang/core/env",
}
----

async fn checked(command : String, args : Array[String]) -> String {
  let result = @process.run(command, args, stdout=@process.read_from_process(), stderr=@process.read_from_process(), no_console_window=true)
  assert_eq(result.exit_code, 0, msg=result.stdout_text() + result.stderr_text())
  result.stdout_text().trim().to_owned()
}

async fn copy_file(source : String, destination : String) -> Unit {
  let parts = destination.split("/").map(part => part.to_owned()).collect()
  ignore(parts.pop())
  let parent = parts.join("/")
  if !@fs.exists(parent) { @fs.mkdir(parent, recursive=true) }
  @fs.write_binary(destination, @fs.read_binary(source))
}

async fn main {
  let args = @env.args()
  assert_eq(args.length(), 3, msg="usage: export-wasmgc generated-module new-output-directory")
  let source = args[1]
  let destination = args[2].replace_all(old="\\", new="/")
  assert_false(@fs.exists(destination), msg="Output must be a new directory")
  for name in ["bindings.mbt", "runtime.mjs", "moon.mod", "moon.pkg"] {
    assert_true(@fs.exists(source + "/" + name), msg="Missing generated module file: " + name)
  }
  for name in ["bindings.mbt", "runtime.mjs", "moon.mod", "moon.pkg"] {
    copy_file(source + "/" + name, destination + "/bindings/" + name)
  }
  for name in ["LICENSE", "toolchain.json", "patches/browser-core.json", "patches/core-async-wasmgc.patch", "scripts/prepare-browser-core.mbtx"] {
    copy_file(name, destination + "/" + name)
  }
  @fs.write_text(destination + "/moon.work", "members = [\"bindings\"]\n")
  @fs.write_text(destination + "/PROVENANCE.txt", "Experimental WebSys WasmGC source bundle\nWebSys revision: " + checked("git", ["rev-parse", "HEAD"]) + "\nWebSys working tree status:\n" + checked("git", ["status", "--porcelain"]) + "\nCompiler: " + checked("moon", ["version"]) + "\nCore source and seven-file browser patch are pinned by toolchain.json and patches/browser-core.json. Run scripts/prepare-browser-core.mbtx from this bundle root with the pinned ordinary toolchain; it obtains official core and passes the override only to build children. Bindings and runtime are copied together from the supplied generated directory. This is not a registry release.\n")
  println("Exported experimental WasmGC source bundle: " + destination)
}
